# Hace que el servidor de desarrollo escuche en todas las interfaces de red,
# permitiendo el acceso desde celulares y otros dispositivos en la red local.
HOST=0.0.0.0

# URL pública usada para generar los códigos QR.
# Cambia esta IP por la de tu máquina en la red local si cambia.
# Para producción, usa la URL real del servidor (ej: https://appdrugs.com)
REACT_APP_PUBLIC_URL=http://192.168.1.70:3000

# URL del backend API.
# Se usa HTTP (no HTTPS) para evitar problemas de certificado en el celular.
# El backend escucha en HTTP en el puerto 5071.
REACT_APP_API_URL=http://192.168.1.70:5071/api
